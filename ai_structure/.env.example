# ============================================================================
# 复制成 .env 后按需修改：  cp .env.example .env
#
# 这个文件会被 run_session.sh 以 `set -a; . .env; set +a` 的方式载入，
# 所以写法必须是 shell 的 KEY=VALUE，不要加 export，值里有空格要加引号。
# 所有项都有默认值，只有 AI_EMAIL / AI_PASSWORD 是必填的（要调 AI 时）。
# ============================================================================

# ---------------------------------------------------------------- 必填：AI 账号
# 用于 ai_login.py 换取 JWT。JWT 写到 .token（权限 600），有效期约 7 天；
# 每次排班都会检查，剩余不足 24h 自动重新登录续期（TOKEN_RENEW_H 可调）。
# 本文件复制成 .env 后含明文密码——.env 与 .token 均已 .gitignore，切勿提交。
AI_EMAIL=you@example.com
AI_PASSWORD=your-password

# 是否把程序算出的结构状态拼进 AI 提示词。前向观察期必须保持 0：
# 要测的是程序与 AI 各自独立时是否一致，喂了就变成 AI 复述程序（见 FORWARD_PROTOCOL.md）。
AI_PROMPT_STATE=0

# ---------------------------------------------------------------- 代理
# 中国大陆访问币安与 AI 站点通常需要。留空或注释掉 = 直连。
# 支持 http:// 与 socks5://（socks5 需要 PySocks，见 README 的说明）。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=socks5://127.0.0.1:1080

# ---------------------------------------------------------------- 排班槽位（UTC）
# 默认值由 session_vol.py 的实测结果决定，一般不用改：
#   亚盘 00:30 UTC —— 东京开盘后，且刚好在额度重置（00:00 UTC）之后
#   欧美 14:00 UTC —— 欧美重叠时段波动的峰值小时
# 注意：这里是脚本内部记录用的标签，真正决定执行时间的是 crontab。
# 若服务器时区不是 UTC，crontab 的时间要相应换算，见 install_cron.sh。
SLOT_ASIA=00:30
SLOT_EUUS=14:00

# ---------------------------------------------------------------- 结构分析参数
# θ = ZigZag 百分比阈值。0.30 表示「需要 ≥30% 的反向运动才算一个摆动点」。
# 调小 → 枢轴更多更灵敏但噪声大；调大 → 只保留大级别结构。
THETA=0.30
THETA_ALT=0.20
# 前瞻期限（天）。改这个会改变报告里的表格行数。
HORIZONS=7,15,30,60,90,180,365
# 独立样本下限：某状态的独立观测少于这个数就不给结论。
MIN_INDEP=15

# ---------------------------------------------------------------- 数据与输出
SYMBOL=BTCUSDT
INTERVAL=1h
CSV_NAME=BTCUSDT_1h.csv
# 输出目录。默认是包内 out/。想丢到别处（例如挂载盘）就改这里。
# OUT_DIR=/var/lib/btc-watch
# 币安镜像。data-api.binance.vision 是公开数据端点，不需要 API key。
# 若被墙，可换 https://api.binance.com/api/v3/klines
# BINANCE_KLINES=https://api.binance.com/api/v3/klines

# ---------------------------------------------------------------- 图表窗口
CHART_W=1560
DAILY_DAYS=430
H4_DAYS=60

# ---------------------------------------------------------------- 外部 AI 端点
# 一般不用改。若对方改了域名，改这两行即可。
AI_BASE=https://ai.yss-signal.com
AI_ORIGIN=https://www.yss-signal.com
